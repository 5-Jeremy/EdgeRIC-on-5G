    },
    {
      "label": "iperf server",
      "type": "shell",
      // The sleep command is to give time for the network namespaces to be created before starting the iperf server.
      "command": "docker exec -it srsran_gnb bash -lc \"cd traffic-generator && sleep 5 && bash iperf_server_2ues.sh; exec bash\"",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
      "options": { "cwd": "/data1/jcarleton/EdgeRIC-on-5G/docker" }
