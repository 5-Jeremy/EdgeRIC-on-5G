      "label": "RUN UEs",
      "type": "shell",
      "command": "docker exec -it srsran_gnb bash -lc \"ip netns del ue1 && ip netns add ue1 && ip netns del ue2 && ip netns add ue2 && bash run2ue-zmq-mode.sh; exec bash\"",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      },
